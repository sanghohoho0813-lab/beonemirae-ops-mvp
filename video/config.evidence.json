  "watermark": "예시 데이터 · 기능 시연용",

  "//stage": "짧은 Demo 와 같은 무대입니다. coverAtStart 하나만 다릅니다 — 여는 글자 화면으로 시작하므로 앱이 뜨는 동안을 가려 둡니다.",
  "stage": {
    "rootFontPx": 19.5,
    "sidebarZoom": 0.48,
    "dim": 0.09,
    "spotBorder": 0.58,
    "spotGlow": 0.11,
    "mainPadPx": 44,
    "mainTopPx": 30,
    "mainBottomPx": 110,
    "cursorPx": 30,
    "chipFontPx": 15,
    "markFontPx": 16,
    "edgePx": 18,
    "coverAtStart": true
  },

  "//tts": "⚠ 최종 음성은 대표님이 직접 녹음하신 파일 하나입니다. piper 는 **타이밍을 맞춰 보는 용도로만** 씁니다 — 저품질 TTS 를 최종 영상에 넣지 않습니다.",
  "tts": {
    "provider": "piper",
    "voices": {
      "piper": {
        "lengthScale": 1.25,
        "noiseScale": 0.5,
        "noiseW": 0.6,
        "sentenceSilence": 0.25
      }
    }
  },

  "//voiceover": "대표님이 읽으실 원문은 video/voiceover-script.evidence.txt 에 있습니다. 녹음하신 파일을 아래 자리에 넣고 marks 만 적으면 됩니다. ⚠ 짧은 Demo 의 voiceover.wav 와 다른 파일입니다.",
  "voiceover": {
    "file": "video/audio/voiceover.evidence.wav",
    "gapSec": 0.6,
    "//예시": { "intro": "0:00.50", "p1": ["0:15.20", "0:33.10"], "end": "2:28.00" },
    "marks": {
      "intro": null,
      "p1": null,
      "p2": null,
      "p3": null,
      "p4": null,
      "p5": null,
      "p6": null,
      "p7": null,
      "outro": null,
      "end": null
    }
  },

  "subtitle": {
    "charsPerLine": 26,
    "bottomPx": 42,
    "maxWidthPct": 72,
    "fontPx": 32,
    "lineHeight": 1.35
  },

  "//out": "짧은 Demo 와 파일이 섞이지 않게 이름을 전부 따로 둡니다 — 음성 폴더까지.",
  "out": {
    "dir": "video/out",
    "voice": "voice-evidence",
    "webm": "evidence.webm",
    "mp4": "beonemirae-ax-evidence.mp4",
    "mp4Silent": "silent-beonemirae-ax-evidence.mp4",
    "timeline": "timeline.evidence.json"
  },
  "length": { "minSec": 125, "maxSec": 165 },

